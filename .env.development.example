# Desarrollo local. Lo usan `expo start`, `expo run:ios` y `expo run:android`.
#
#   cp .env.development.example .env.development
#
# La IP debe ser la de tu máquina en la red local (no localhost) para que el
# simulador o el dispositivo físico puedan alcanzar el backend.

EXPO_PUBLIC_STAGE=dev

EXPO_PUBLIC_API_URL_IOS=http://192.168.1.1:3000/api
EXPO_PUBLIC_API_URL_ANDROID=http://192.168.1.1:3000/api
