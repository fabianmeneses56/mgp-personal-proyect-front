# Variables compartidas entre todos los modos.
#
#   cp .env.example .env
#
# Ver también .env.development.example y .env.production.example.
#
# Expo resuelve los archivos según NODE_ENV, de mayor a menor prioridad:
#   .env.${NODE_ENV}.local -> .env.local -> .env.${NODE_ENV} -> .env
# NODE_ENV lo pone Expo CLI: "development" en `expo start` y builds Debug,
# "production" en `expo export`, builds Release y EAS Build.

E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
